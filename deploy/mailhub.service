[Unit]
Description=MailHub Governance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailhub
Group=mailhub
WorkingDirectory=/opt/mailhub
EnvironmentFile=/opt/mailhub/.env
ExecStart=/opt/mailhub/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8018 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mailhub/data
MemoryMax=512M
UMask=0077

[Install]
WantedBy=multi-user.target
