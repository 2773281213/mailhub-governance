<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 后台通知：API 33 起需要运行时申请，申请由集成任务弹出 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 周期任务设了 setPersisted(true)，开机后由系统恢复调度 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MailHubApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MailHub">

        <!--
            singleTop：浏览器授权页通过 mailhub://oauth/done?tx=… 返回时复用已有实例，
            走 onNewIntent，不会重建界面。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth 回调深链：只有事务 id，不带任何令牌。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:path="/done"
                    android:scheme="mailhub" />
            </intent-filter>
        </activity>

        <!-- 拉取 /api/changes 的周期任务：只允许系统的 JobScheduler 绑定，不对外导出 -->
        <service
            android:name=".work.ChangesJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
