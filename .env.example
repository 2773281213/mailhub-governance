# Required: generate a long random value (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
# and keep it outside Git. It encrypts stored credentials and signs sessions.
MAILHUB_SECRET=replace-with-a-long-random-secret

# Optional local database path.
MAILHUB_DB=data/mailhub.db

# Public base URL used for OAuth callback links. Production must use your own HTTPS domain.
MAILHUB_PUBLIC_URL=http://127.0.0.1:8018

# Optional OAuth client configuration. These complete environment pairs override
# settings-page values; Microsoft Client ID alone can enable public device flow.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NetEase (163/126/yeah/188/VIP) OAuth. Requires an appid that NetEase approved for
# this deployment; leave empty to use client authorization passwords instead.
NETEASE_CLIENT_ID=
# Stable per-deployment device id; generated once and stored in settings when empty.
NETEASE_DEVICE_ID=

# Per-brand callback URLs; default to ${MAILHUB_PUBLIC_URL}/api/oauth/<brand>/callback
NETEASE_163_REDIRECT_URI=
NETEASE_126_REDIRECT_URI=
NETEASE_YEAH_REDIRECT_URI=
NETEASE_188_REDIRECT_URI=
NETEASE_VIP163_REDIRECT_URI=
NETEASE_VIP126_REDIRECT_URI=
NETEASE_VIP188_REDIRECT_URI=
