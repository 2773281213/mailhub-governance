# Optional OAuth client configuration. These complete environment pairs override
# settings-page values; Microsoft Client ID alone can enable public device flow.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NetEase (163/126/yeah/188/VIP) partner OAuth.
# NETEASE_CHANNEL=own      -> use your own NetEase-approved appid (NETEASE_CLIENT_ID)
# NETEASE_CHANNEL=outlook  -> reuse the partner identity extracted from Outlook 5.2606.0
#                             (appid rjg1fubwqzie5unhx6) without a NetEase approval
NETEASE_CHANNEL=own
NETEASE_CLIENT_ID=
# Stable per-deployment device id; generated once and stored in settings when empty.
NETEASE_DEVICE_ID=

# web      -> our own HTTPS callback (fragment capture; the only mode that completes in a browser)
# olmoauth -> the Outlook relay URL from the APK (protocol parity / probing only)
NETEASE_REDIRECT_STYLE=web
NETEASE_OLMOAUTH_PACKAGE=com.microsoft.office.outlook

# Per-brand callback URLs; default to ${MAILHUB_PUBLIC_URL}/api/oauth/<brand>/callback
NETEASE_163_REDIRECT_URI=
NETEASE_126_REDIRECT_URI=
NETEASE_YEAH_REDIRECT_URI=
NETEASE_188_REDIRECT_URI=
NETEASE_VIP163_REDIRECT_URI=
NETEASE_VIP126_REDIRECT_URI=
NETEASE_VIP188_REDIRECT_URI=
