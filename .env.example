# Required: generate a long random value and keep it outside Git.
MAILHUB_SECRET=replace-with-a-long-random-secret

# Optional local database path.
MAILHUB_DB=data/mailhub.db

# Optional public base URL used by OAuth callback links.
MAILHUB_PUBLIC_URL=http://127.0.0.1:8018

# Optional OAuth client configuration. These complete environment pairs override
# settings-page values; Microsoft Client ID alone can enable public device flow.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
